# Aplicación
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL (use DATABASE_URL o el bloque PG_*, nunca ambos)
DATABASE_URL=postgresql://usuario:password@localhost:5432/gpg_seguros
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=postgres
# PG_PASSWORD=
# PG_DATABASE=gpg_seguros

# TLS: en servicios remotos queda activo y valida certificados por defecto
# PGSSL=true
# PGSSL_REJECT_UNAUTHORIZED=true
# PGSSL_CA_BASE64=

# Pool y límites operativos
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=10000
PG_STATEMENT_TIMEOUT_MS=15000
PG_IDLE_TX_TIMEOUT_MS=30000

# Seguridad
JWT_SECRET=reemplazar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
SESSION_TTL_HOURS=8
GOOGLE_CLIENT_ID=

# Solo desarrollo explícito. Nunca habilitar en producción.
SEED_DEFAULT_USERS=false

# Base descartable exclusiva para npm run test:db
TEST_DATABASE_URL=postgresql://usuario:password@localhost:5432/gpg_seguros_test
